# Secrets
.env
.env.*
!.env.example

# Local build output
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/

# Runtime data (databases are rebuilt by the seed script)
*.db
*.db-journal
*.db-wal
*.db-shm
runtime/

# Organiser material, not ours to publish
*.pdf

# Synapse local state: encrypted API key, session logs, scan cache
**/.synapse/

# Firebase deploy cache
.firebase/

# The film is served only by the website's player (no download button), so the video file stays out of the repo.
# It is rendered in the video project and copied here before a deploy.
site/assets/film/*.mp4
